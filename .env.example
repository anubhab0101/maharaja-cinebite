# CineBites Production Environment Configuration Template
# Copy this file to .env and configure the secrets for your production deployment.

# ==========================================
# 1. Server & Networking
# ==========================================
NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=https://cinebites.yourtheatre.com

# ==========================================
# 2. Database (MySQL / TiDB)
# ==========================================
# Connection string format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://cinebites_user:your_secure_db_password@localhost:3306/cinebites

# ==========================================
# 3. Security & Cryptography
# ==========================================
# Generate a strong 64-character hex secret for signing JWT session tokens:
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-cryptographically-secure-32-byte-hex-secret-here

# ==========================================
# 4. Payment Gateway (Razorpay India)
# ==========================================
# Get credentials from your Razorpay Dashboard (Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ==========================================
# 5. OAuth & Staff Authentication
# ==========================================
OAUTH_SERVER_URL=https://auth.yourtheatre.com
VITE_OAUTH_PORTAL_URL=https://auth.yourtheatre.com
VITE_APP_ID=cinebites-cinema-app
OWNER_OPEN_ID=owner_admin_openid_placeholder
