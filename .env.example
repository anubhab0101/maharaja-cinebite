# CineBites Production Environment Configuration Template
# Copy this file to .env and configure the secrets for your production deployment.

# ==========================================
# 1. Server & Networking
# ==========================================
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
# Production: NODE_ENV=production and your exact public HTTPS origin above.
ENABLE_DEV_LOGIN=false
# Exact reverse-proxy IP addresses/CIDRs only; leave empty for direct connections.
# Never use 0.0.0.0/0, ::/0, or blanket trust.
TRUSTED_PROXY_CIDRS=

# ==========================================
# 2. Database (MySQL / TiDB)
# ==========================================
# Connection string format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://cinebites_user:your_secure_db_password@localhost:3306/cinebites

# ==========================================
# 3. Security & Cryptography
# ==========================================
# Generate a strong 64-character hex secret for signing JWT session tokens:
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-cryptographically-secure-32-byte-hex-secret-here

# ==========================================
# 4. Payment Gateway (Razorpay India)
# ==========================================
# Get credentials from your Razorpay Dashboard (Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_replace_with_dashboard_key
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
# Configure /api/webhooks/razorpay for payment.captured and order.paid events.
RAZORPAY_WEBHOOK_SECRET=
# Use test keys locally, not live payment credentials.

# ==========================================
# 5. OAuth & Staff Authentication
# ==========================================
VITE_APP_ID=cinebites-cinema-app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google redirect URI: PUBLIC_APP_URL + /api/auth/google/callback
OWNER_EMAIL=
# Comma-separated trusted owner-level administrators, not ordinary staff.
ADMIN_EMAILS=
# Legacy Manus OAuth is optional; not required for Google login.
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
# Never put secrets in VITE_ variables: these are exposed to the browser.

# Optional customer offer push. Disabled until notice approval + provider testing.
# Generate one VAPID keypair privately; never put the private key in VITE_ variables.
OFFERS_PUSH_ENABLED=false
OFFERS_NOTICE_APPROVED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
