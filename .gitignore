# ==========================================
# CineBites - Production .gitignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/
.pnpm-store/
jspm_packages/

# Environment variables & secrets (CRITICAL: never commit credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# SSL & Security keys / certs
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Build outputs
dist/
build/
out/
*.dist
*.tsbuildinfo

# Vite & Bundle caches
.cache/
.parcel-cache/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Framework outputs
.next/
.nuxt/
.vuepress/dist/

# Test & Coverage
coverage/
*.lcov
.nyc_output/
.vitest/

# Logs & Debuggers
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.manus-logs/

# Runtime data & temp files
pids/
*.pid
*.seed
*.pid.lock
tmp/
temp/
*.tmp
*.bak
*.backup
*.old
*.orig
*.swp
*.swo
*~

# Databases
*.db
*.sqlite
*.sqlite3

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE and editor files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# AI / Assistant / Tooling artifacts
.gemini/
.antigravity/
.cursor/
.webdev/
client/public/__manus__/
.project-config.json
template.json
